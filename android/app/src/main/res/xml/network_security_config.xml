<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- The app allows the user to point at a self-hosted backend via an
         "Advanced" server URL field, which may use http:// for local/LAN
         servers (e.g. http://192.168.1.10:3001). Permit cleartext traffic to
         private/local addresses so self-hosting keeps working, while keeping
         the default deny-cleartext posture for public hosts. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.0.0</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
